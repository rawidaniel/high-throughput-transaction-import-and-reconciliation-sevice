DATABASE_URL="postgresql://postgres:postgres@localhost:5432/transactions?schema=public"

# Core 
PORT=3000
LOG_LEVEL=info

# Upload & security
MAX_UPLOAD_BYTES=524288000
JSON_BODY_LIMIT_BYTES=65536
REQUEST_TIMEOUT_MS=300000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW="1 minute"
MAX_CONCURRENT_UPLOADS=10

# Processing
PERSIST_BATCH_SIZE=500
SCORING_BATCH_SIZE=500
MAX_CONCURRENT_PERSISTS=2
WORKER_POOL_SIZE=4
RISK_SCORING_HASH_ROUNDS=600

# Jobs & recovery
LEASE_DURATION_MS=120000
MAX_JOB_ATTEMPTS=3
RECLAIM_INTERVAL_MS=30000
SHUTDOWN_GRACE_MS=15000
WORKER_SHUTDOWN_GRACE_MS=30000
SHUTDOWN_DRAIN_MS=3000

# Retry
RETRY_MAX_ATTEMPTS=4
RETRY_BASE_DELAY_MS=200
RETRY_MAX_DELAY_MS=5000

# Observability
WORKER_METRICS_PORT=3001
METRICS_SAMPLE_INTERVAL_MS=5000
ORPHAN_SWEEP_INTERVAL_MS=3600000
ORPHAN_FILE_AGE_MS=86400000


